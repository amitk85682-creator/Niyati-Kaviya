# ==============================================================================
# 🤖 BOT TOKENS
# Get these from @BotFather on Telegram
# ==============================================================================
NIYATI_BOT_TOKEN="your_niyati_telegram_token_here"
NIYATI_BOT_USERNAME="your_niyati_bot_username"

PALAK_BOT_TOKEN="your_palak_telegram_token_here"
PALAK_BOT_USERNAME="your_palak_bot_username"


# ==============================================================================
# 🧠 AI PROVIDERS
# Configure which AI models to use for each bot
# Providers supported: openai, groq, gemini
# ==============================================================================
# Niyati's Configuration
NIYATI_AI_PROVIDER="groq"
NIYATI_AI_MODEL="llama3-70b-8192"

# Palak's Configuration
PALAK_AI_PROVIDER="gemini"
PALAK_AI_MODEL="gemini-1.5-pro"

# API Keys (Provide at least the ones you selected above)
OPENAI_API_KEYS=["sk-proj-your-openai-key"]
GROQ_API_KEYS=["gsk_your-groq-key"]
GEMINI_API_KEYS=["AIzaSyYourGeminiKey"]


# ==============================================================================
# 💾 DATABASE (Supabase / Local)
# If SUPABASE_URL is empty, it uses a local SQLite file (data.db)
# ==============================================================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"


# ==============================================================================
# ⚙️ SYSTEM SETTINGS
# ==============================================================================
# Timezone for logs and scheduled jobs
DEFAULT_TIMEZONE="Asia/Kolkata"

# Developer / Admin IDs (comma separated integers)
ADMIN_IDS=[123456789]
